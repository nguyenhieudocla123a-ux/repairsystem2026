# Sao chép thành file .env rồi thay các giá trị CHANGE_ME. File .env đã nằm trong .gitignore – KHÔNG commit.
# Docker Compose và Backend (khi chạy từ IDE/Maven) đều đọc file này.

# ---------- PostgreSQL ----------
POSTGRES_DB=repairflow
POSTGRES_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/repairflow
DB_USERNAME=repairflow
DB_PASSWORD=CHANGE_ME_db_password

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# ---------- Backend ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
# Dùng từ Mốc 4 – chuỗi ngẫu nhiên >= 32 byte, ví dụ: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
