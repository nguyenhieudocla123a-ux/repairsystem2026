# Sao chép thành file .env rồi thay các giá trị CHANGE_ME. File .env đã nằm trong .gitignore – KHÔNG commit.
# Docker Compose và Backend (khi chạy từ IDE/Maven) đều đọc file này.

# ---------- PostgreSQL ----------
POSTGRES_DB=repairflow
POSTGRES_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/repairflow
DB_USERNAME=repairflow
DB_PASSWORD=CHANGE_ME_db_password

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# ---------- Backend ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
# Dùng từ Mốc 4 – chuỗi ngẫu nhiên >= 32 byte, ví dụ: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
# Cookie refresh token chỉ gửi qua HTTPS. Trình duyệt vẫn chấp nhận trên http://localhost nên để true cả khi dev.
AUTH_COOKIE_SECURE=true
# Link trong email đặt lại mật khẩu trỏ về Frontend
FRONTEND_URL=http://localhost:5173

# ---------- Email (mã xác nhận đăng ký) – để trống MAIL_HOST: dev in mã ra log backend ----------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=RepairFlow <no-reply@repairflow.local>

# ---------- Đăng nhập Google / Facebook – để trống = ẩn nút (xem docs/social-login.md) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---------- Dữ liệu demo (chỉ profile dev) ----------
# Mật khẩu chung cho 4 tài khoản demo: admin@ / staff@ / tech@ / customer@repairflow.local
# Cần >= 8 ký tự, có chữ hoa, chữ thường, chữ số. Để trống = không tạo tài khoản demo.
DEMO_USER_PASSWORD=
