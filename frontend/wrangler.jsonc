// Cloudflare Workers: phát bản build của frontend (dist/) + chuyển tiếp /api và /ws tới backend Spring Boot.
// Deploy: `npm run build` rồi `npx wrangler deploy` (Workers Builds: Root directory = frontend, Build command = npm run build).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repairsystem2026",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",
  // wrangler deploy tự build trước (không phụ thuộc Build command trên Dashboard)
  "build": {
    "command": "npm run build"
  },
  "assets": {
    // Phát file ĐÃ BUILD – không phải mã nguồn (index.html gốc trỏ /src/main.tsx, trình duyệt không chạy được)
    "directory": "./dist",
    "binding": "ASSETS",
    // React Router: đường dẫn không phải file (/dashboard, /inventory…) trả index.html
    "not_found_handling": "single-page-application",
    // Chỉ các đường dẫn này chạy qua Worker; còn lại Cloudflare phát thẳng file tĩnh kèm Content-Type đúng
    "run_worker_first": ["/api/*", "/ws", "/ws/*"]
  },
  // Backend Spring Boot trên máy chủ cửa hàng, nối qua Cloudflare Tunnel "repairflow-backend" bằng Workers VPC
  // (VPC Service "repairflow-backend" → localhost:8080) – không cần tên miền hay địa chỉ công khai cho backend.
  "vpc_services": [
    { "binding": "BACKEND", "service_id": "01a211fe-69ab-7ea2-b12e-ffa6c9d81b9e" }
  ],
  // BACKEND_ORIGIN (tuỳ chọn, vd. https://api.example.com) đặt ở Dashboard → Settings → Variables;
  // keep_vars để mỗi lần deploy không xoá giá trị đó.
  "keep_vars": true
}
