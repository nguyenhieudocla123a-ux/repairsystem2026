# Sao chép thành .env.local nếu cần thay đổi. Không chứa bí mật – mọi biến VITE_* đều lộ ra trình duyệt.

# Đường dẫn gốc API. Mặc định dùng đường dẫn tương đối /api/v1 (đi qua Vite proxy khi dev, Nginx khi production).
VITE_API_BASE_URL=/api/v1

# Chỉ dùng cho Vite dev server: backend mà proxy chuyển tiếp tới.
VITE_DEV_API_TARGET=http://localhost:8080
